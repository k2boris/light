stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS party_id FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''SFDC'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: CRM_SF_DS
          sql:
            const: SELECT * FROM (select * from main.sf_identity_document) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                identifier_id: scalar(document_id),
                party_id: scalar(parent_party_id),
                id_type: scalar(doc_type),
                id_value: scalar(doc_number_masked),
                issuing_country: scalar(issuing_country),
                issuing_region: scalar(issuing_region),
                expiration_date: scalar(expiration_date),
                verified_flag: "0"
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          document_id:
            link:
              path: QueryJoin/result/document_id
              iterate: Iterate
            schema: string
            mandatory: false
          party_id:
            link:
              path: QueryJoin/result/party_id
              iterate: Iterate
            schema: string
            mandatory: false
          doc_type:
            link:
              path: QueryJoin/result/doc_type
              iterate: Iterate
            schema: string
            mandatory: false
          doc_number_masked:
            link:
              path: QueryJoin/result/doc_number_masked
              iterate: Iterate
            schema: string
            mandatory: false
          issuing_country:
            link:
              path: QueryJoin/result/issuing_country
              iterate: Iterate
            schema: string
            mandatory: false
          issuing_region:
            link:
              path: QueryJoin/result/issuing_region
              iterate: Iterate
            schema: string
            mandatory: false
          expiration_date:
            link:
              path: QueryJoin/result/expiration_date
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_PARTY_IDENTIFIER:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - identifier_id
              - party_id
              - id_type
              - id_value
              - issuing_country
              - issuing_region
              - expiration_date
              - verified_flag
          keys:
            const:
              - identifier_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          identifier_id:
            link: ProjectRows/result/identifier_id
            schema: string
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          id_type:
            link: ProjectRows/result/id_type
            schema: string
          id_value:
            link: ProjectRows/result/id_value
            schema: string
          issuing_country:
            link: ProjectRows/result/issuing_country
            schema: string
          issuing_region:
            link: ProjectRows/result/issuing_region
            schema: string
          expiration_date:
            link: ProjectRows/result/expiration_date
            schema: string
          verified_flag:
            link: ProjectRows/result/verified_flag
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        document_id:
          type: string
        party_id:
          type: string
        doc_type:
          type: string
        doc_number_masked:
          type: string
        issuing_country:
          type: string
        issuing_region:
          type: string
        expiration_date:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        identifier_id:
          type: string
        party_id:
          type: string
        id_type:
          type: string
        id_value:
          type: string
        issuing_country:
          type: string
        issuing_region:
          type: string
        expiration_date:
          type: string
        verified_flag:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
