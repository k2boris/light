stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        out:
          parent_rows:
            schema: '#ref'
        in:
          screening_hit_id:
            external: screening_hit_id
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Stage 2:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ screening_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/screening_hit_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: CORE_TMNS_DS
          sql:
            const: SELECT * FROM (select * from main.payment_screening) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
          luid_column_name:
            const: select screening_id, result_code, reason_codes, analyst_user, screened_at from CORE_TMNS_DS.payment_screening
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors: {}
  Stage 1:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: TMNS payment screening disposition
            schema: string
        out:
          value:
            schema: string
  LU Table:
    last: 1
    actors:
      BI_SCREENING_DISPOSITION:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - disposition_id
              - screening_hit_id
              - disposition_code
              - disposition_reason
              - decided_by
              - decided_at
              - notes
          keys:
            const:
              - disposition_id
          dialect:
            const: sqlite
          command:
            const: upsert
          disposition_id:
            link: Query/result/screening_id
            schema: string
          screening_hit_id:
            link: Query/result/screening_id
            schema: string
          disposition_code:
            link: Query/result/result_code
            schema: string
          disposition_reason:
            link: Query/result/reason_codes
            schema: string
          decided_by:
            link: Query/result/analyst_user
            schema: string
          decided_at:
            link: Query/result/screened_at
            schema: string
          notes:
            link: Const1/value
            schema: string
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        screening_hit_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        screening_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        screening_id:
          type: string
        result_code:
          type: string
        reason_codes:
          type: string
        analyst_user:
          type: string
        screened_at:
          type: string
  BI_SCREENING_DISPOSITION.in.disposition_id:
    type: array
    items:
      type: string
  BI_SCREENING_DISPOSITION.in.screening_hit_id:
    type: array
    items:
      type: string
  BI_SCREENING_DISPOSITION.in.disposition_code:
    type: array
    items:
      type: string
  BI_SCREENING_DISPOSITION.in.disposition_reason:
    type: array
    items:
      type: string
  BI_SCREENING_DISPOSITION.in.decided_by:
    type: array
    items:
      type: string
  BI_SCREENING_DISPOSITION.in.decided_at:
    type: array
    items:
      type: string
