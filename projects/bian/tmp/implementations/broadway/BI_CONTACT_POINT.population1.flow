stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS party_id FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''SFDC'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: CRM_SF_DS
          sql:
            const: SELECT * FROM (select * from main.sf_contact_point) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                contact_point_id: scalar(contact_point_id),
                party_id: scalar(parent_party_id),
                contact_type: scalar(contact_type),
                contact_value: scalar(contact_value),
                is_primary: scalar(is_primary),
                verified_flag: scalar(verified_flag),
                verified_at: scalar(verified_at)
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          contact_point_id:
            link:
              path: QueryJoin/result/contact_point_id
              iterate: Iterate
            schema: string
            mandatory: false
          party_id:
            link:
              path: QueryJoin/result/party_id
              iterate: Iterate
            schema: string
            mandatory: false
          contact_type:
            link:
              path: QueryJoin/result/contact_type
              iterate: Iterate
            schema: string
            mandatory: false
          contact_value:
            link:
              path: QueryJoin/result/contact_value
              iterate: Iterate
            schema: string
            mandatory: false
          is_primary:
            link:
              path: QueryJoin/result/is_primary
              iterate: Iterate
            schema: string
            mandatory: false
          verified_flag:
            link:
              path: QueryJoin/result/verified_flag
              iterate: Iterate
            schema: string
            mandatory: false
          verified_at:
            link:
              path: QueryJoin/result/verified_at
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_CONTACT_POINT:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - contact_point_id
              - party_id
              - contact_type
              - contact_value
              - is_primary
              - verified_flag
              - verified_at
          keys:
            const:
              - contact_point_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          contact_point_id:
            link: ProjectRows/result/contact_point_id
            schema: string
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          contact_type:
            link: ProjectRows/result/contact_type
            schema: string
          contact_value:
            link: ProjectRows/result/contact_value
            schema: string
          is_primary:
            link: ProjectRows/result/is_primary
            schema: string
          verified_flag:
            link: ProjectRows/result/verified_flag
            schema: string
          verified_at:
            link: ProjectRows/result/verified_at
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        contact_point_id:
          type: string
        party_id:
          type: string
        contact_type:
          type: string
        contact_value:
          type: string
        is_primary:
          type: string
        verified_flag:
          type: string
        verified_at:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        contact_point_id:
          type: string
        party_id:
          type: string
        contact_type:
          type: string
        contact_value:
          type: string
        is_primary:
          type: string
        verified_flag:
          type: string
        verified_at:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
