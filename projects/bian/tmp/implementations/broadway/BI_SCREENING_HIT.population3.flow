stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        out:
          parent_rows:
            schema: '#ref'
        in:
          screening_hit_id:
            external: screening_hit_id
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Stage 2:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ listing_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/screening_hit_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: DOWJONES_DS
          sql:
            const: SELECT * FROM (select * from main.dj_listing) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
          luid_column_name:
            const: select listing_id, entity_id, listing_type, program_name, created_at from DOWJONES_DS.dj_listing
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors: {}
  Stage 1:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: DOWJONES
            schema: string
        out:
          value:
            schema: string
      Const2:
        parent: Const
        in:
          value:
            const: OPEN
            schema: string
        out:
          value:
            schema: string
  LU Table:
    last: 1
    actors:
      BI_SCREENING_HIT:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - screening_hit_id
              - screening_run_id
              - hit_type
              - provider_code
              - provider_entity_id
              - provider_listing_id
              - matched_name
              - hit_status
              - created_at
          keys:
            const:
              - screening_hit_id
          dialect:
            const: sqlite
          command:
            const: upsert
          screening_hit_id:
            link: Query/result/listing_id
            schema: string
          screening_run_id:
            link: Query/result/entity_id
            schema: string
          hit_type:
            link: Query/result/listing_type
            schema: string
          provider_code:
            link: Const1/value
            schema: string
          provider_entity_id:
            link: Query/result/entity_id
            schema: string
          provider_listing_id:
            link: Query/result/listing_id
            schema: string
          matched_name:
            link: Query/result/program_name
            schema: string
          hit_status:
            link: Const2/value
            schema: string
          created_at:
            link: Query/result/created_at
            schema: string
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        screening_hit_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        listing_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        listing_id:
          type: string
        entity_id:
          type: string
        listing_type:
          type: string
        program_name:
          type: string
        created_at:
          type: string
  BI_SCREENING_HIT.in.screening_hit_id:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.screening_run_id:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.hit_type:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.provider_entity_id:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.provider_listing_id:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.matched_name:
    type: array
    items:
      type: string
  BI_SCREENING_HIT.in.created_at:
    type: array
    items:
      type: string
