stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS party_id FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''ORACLE_AML'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: AML_ORA_DS
          sql:
            const: SELECT * FROM (select * from main.aml_party) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                identifier_id: scalar(party_id),
                party_id: scalar(parent_party_id),
                id_type: "SSN_LAST4",
                id_value: scalar(tax_id_last4),
                issuing_country: scalar(country_of_res),
                verified_flag: "0"
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          party_id:
            link:
              path: QueryJoin/result/party_id
              iterate: Iterate
            schema: string
            mandatory: false
          tax_id_last4:
            link:
              path: QueryJoin/result/tax_id_last4
              iterate: Iterate
            schema: string
            mandatory: false
          country_of_res:
            link:
              path: QueryJoin/result/country_of_res
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_PARTY_IDENTIFIER:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - identifier_id
              - party_id
              - id_type
              - id_value
              - issuing_country
              - verified_flag
          keys:
            const:
              - identifier_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          identifier_id:
            link: ProjectRows/result/identifier_id
            schema: string
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          id_type:
            link: ProjectRows/result/id_type
            schema: string
          id_value:
            link: ProjectRows/result/id_value
            schema: string
          issuing_country:
            link: ProjectRows/result/issuing_country
            schema: string
          verified_flag:
            link: ProjectRows/result/verified_flag
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        tax_id_last4:
          type: string
        country_of_res:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        identifier_id:
          type: string
        party_id:
          type: string
        id_type:
          type: string
        id_value:
          type: string
        issuing_country:
          type: string
        verified_flag:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
