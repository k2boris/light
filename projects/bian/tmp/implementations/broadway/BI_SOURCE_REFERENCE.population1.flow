stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS entity_id FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''DJ'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: DOWJONES_DS
          sql:
            const: SELECT * FROM (select * from main.dj_entity) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                source_reference_id: scalar(entity_id),
                party_id: scalar(parent_party_id),
                source_system_id: "DOWJONES",
                source_entity: "dj_entity",
                source_key: scalar(entity_id),
                is_primary_in_source: "1",
                effective_from: scalar(created_at),
                created_at: scalar(created_at)
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          entity_id:
            link:
              path: QueryJoin/result/entity_id
              iterate: Iterate
            schema: string
            mandatory: false
          created_at:
            link:
              path: QueryJoin/result/created_at
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_SOURCE_REFERENCE:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - source_reference_id
              - party_id
              - source_system_id
              - source_entity
              - source_key
              - is_primary_in_source
              - effective_from
              - created_at
          keys:
            const:
              - source_reference_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          source_reference_id:
            link: ProjectRows/result/source_reference_id
            schema: string
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          source_system_id:
            link: ProjectRows/result/source_system_id
            schema: string
          source_entity:
            link: ProjectRows/result/source_entity
            schema: string
          source_key:
            link: ProjectRows/result/source_key
            schema: string
          is_primary_in_source:
            link: ProjectRows/result/is_primary_in_source
            schema: string
          effective_from:
            link: ProjectRows/result/effective_from
            schema: string
          created_at:
            link: ProjectRows/result/created_at
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        entity_id:
          type: string
        created_at:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        source_reference_id:
          type: string
        party_id:
          type: string
        source_system_id:
          type: string
        source_entity:
          type: string
        source_key:
          type: string
        is_primary_in_source:
          type: string
        effective_from:
          type: string
        created_at:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        entity_id:
          type: string
