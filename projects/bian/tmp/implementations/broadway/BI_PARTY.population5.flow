stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS ROWID_OBJECT FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''MDM'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: SELECT * FROM (select * from main.C_BO_PARTY) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                party_id: scalar(parent_party_id),
                party_type: scalar(PARTY_TYPE_CD),
                status_code: scalar(STATUS_CD),
                created_at: scalar(CREATED_DT),
                updated_at: scalar(UPDATED_DT)
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          ROWID_OBJECT:
            link:
              path: QueryJoin/result/ROWID_OBJECT
              iterate: Iterate
            schema: string
            mandatory: false
          PARTY_TYPE_CD:
            link:
              path: QueryJoin/result/PARTY_TYPE_CD
              iterate: Iterate
            schema: string
            mandatory: false
          STATUS_CD:
            link:
              path: QueryJoin/result/STATUS_CD
              iterate: Iterate
            schema: string
            mandatory: false
          CREATED_DT:
            link:
              path: QueryJoin/result/CREATED_DT
              iterate: Iterate
            schema: string
            mandatory: false
          UPDATED_DT:
            link:
              path: QueryJoin/result/UPDATED_DT
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_PARTY:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - party_id
              - party_type
              - status_code
              - created_at
              - updated_at
          keys:
            const:
              - party_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          party_type:
            link: ProjectRows/result/party_type
            schema: string
          status_code:
            link: ProjectRows/result/status_code
            schema: string
          created_at:
            link: ProjectRows/result/created_at
            schema: string
          updated_at:
            link: ProjectRows/result/updated_at
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
        PARTY_TYPE_CD:
          type: string
        STATUS_CD:
          type: string
        CREATED_DT:
          type: string
        UPDATED_DT:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        party_type:
          type: string
        status_code:
          type: string
        created_at:
          type: string
        updated_at:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
