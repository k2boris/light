stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ ROWID_OBJECT: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: MDM_INFA_DS
          sql:
            const: 'SELECT SOURCE_KEY AS party_id FROM main.C_XREF_PARTY WHERE SYSTEM_CODE = ''SFDC'''
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: CRM_SF_DS
          sql:
            const: SELECT * FROM (select * from main.sf_party_person) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                party_id: scalar(parent_party_id),
                first_name: scalar(first_name),
                middle_name: scalar(middle_name),
                last_name: scalar(last_name),
                date_of_birth: scalar(date_of_birth),
                citizenship_code: scalar(citizenship_code),
                residency_country: scalar(residency_code),
                occupation: scalar(occupation),
                employer_name: scalar(employer_name),
                gender_code: "U"
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          party_id:
            link:
              path: QueryJoin/result/party_id
              iterate: Iterate
            schema: string
            mandatory: false
          first_name:
            link:
              path: QueryJoin/result/first_name
              iterate: Iterate
            schema: string
            mandatory: false
          middle_name:
            link:
              path: QueryJoin/result/middle_name
              iterate: Iterate
            schema: string
            mandatory: false
          last_name:
            link:
              path: QueryJoin/result/last_name
              iterate: Iterate
            schema: string
            mandatory: false
          date_of_birth:
            link:
              path: QueryJoin/result/date_of_birth
              iterate: Iterate
            schema: string
            mandatory: false
          citizenship_code:
            link:
              path: QueryJoin/result/citizenship_code
              iterate: Iterate
            schema: string
            mandatory: false
          residency_code:
            link:
              path: QueryJoin/result/residency_code
              iterate: Iterate
            schema: string
            mandatory: false
          occupation:
            link:
              path: QueryJoin/result/occupation
              iterate: Iterate
            schema: string
            mandatory: false
          employer_name:
            link:
              path: QueryJoin/result/employer_name
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      BI_PERSON:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - party_id
              - first_name
              - middle_name
              - last_name
              - date_of_birth
              - citizenship_code
              - residency_country
              - occupation
              - employer_name
              - gender_code
          keys:
            const:
              - party_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          first_name:
            link: ProjectRows/result/first_name
            schema: string
          middle_name:
            link: ProjectRows/result/middle_name
            schema: string
          last_name:
            link: ProjectRows/result/last_name
            schema: string
          date_of_birth:
            link: ProjectRows/result/date_of_birth
            schema: string
          citizenship_code:
            link: ProjectRows/result/citizenship_code
            schema: string
          residency_country:
            link: ProjectRows/result/residency_country
            schema: string
          occupation:
            link: ProjectRows/result/occupation
            schema: string
          employer_name:
            link: ProjectRows/result/employer_name
            schema: string
          gender_code:
            link: ProjectRows/result/gender_code
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        ROWID_OBJECT:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        first_name:
          type: string
        middle_name:
          type: string
        last_name:
          type: string
        date_of_birth:
          type: string
        citizenship_code:
          type: string
        residency_code:
          type: string
        occupation:
          type: string
        employer_name:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        first_name:
          type: string
        middle_name:
          type: string
        last_name:
          type: string
        date_of_birth:
          type: string
        citizenship_code:
          type: string
        residency_country:
          type: string
        occupation:
          type: string
        employer_name:
          type: string
        gender_code:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
