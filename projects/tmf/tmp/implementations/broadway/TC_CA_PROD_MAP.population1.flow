stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          cust_acct_id:
            external: cust_acct_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              var pfx = "CA_";
              
              self.result = [];
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v && pfx && v.indexOf(pfx) === 0) {
                    v = v.substring(pfx.length);
                  }
                  if (v) self.result.push({ customer_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/cust_acct_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors: {}
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: NCC_SYSTEM
          sql:
            const: |-
              SELECT DISTINCT
                  t1.customer_id AS customer_id,
                  t2.product_id AS product_id
              FROM NCC_SUBSCRIPTION t1
              JOIN NCC_PRODUCT t2 ON t1.subscription_id = t2.subscription_id
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                cust_acct_id: scalar(parent_cust_acct_id),
                product_id: scalar(product_id),
                rel_type: "owns"
              });
              self.result;
          parent_cust_acct_id:
            link: PopulationArgs/parent_rows/cust_acct_id
            schema: string
            mandatory: false
          customer_id:
            link:
              path: QueryJoin/result/customer_id
              iterate: Iterate
            schema: string
            mandatory: false
          product_id:
            link:
              path: QueryJoin/result/product_id
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      TC_CA_PROD_MAP:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - cust_acct_id
              - product_id
              - rel_type
          keys:
            const:
              - cust_acct_id
              - product_id
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          cust_acct_id:
            link: ProjectRows/result/cust_acct_id
            schema: string
          product_id:
            link: ProjectRows/result/product_id
            schema: string
          rel_type:
            link: ProjectRows/result/rel_type
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        cust_acct_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        cust_acct_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
        product_id:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        cust_acct_id:
          type: string
        product_id:
          type: string
        rel_type:
          type: string
