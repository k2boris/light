stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        out:
          parent_rows:
            schema: '#ref'
        in:
          customer_id:
            external: customer_id
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Stage 2:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ customer_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/customer_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: SIEBEL_SYSTEM
          sql:
            const: SELECT * FROM (select * from main.SBL_CUSTOMER) __rowmatch LIMIT 1
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
          luid_column_name:
            const: select customer_id, status, party_id from SIEBEL_SYSTEM.SBL_CUSTOMER
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors: {}
  Stage 1:
    actors:
      Now1:
        parent: Now
  LU Table:
    last: 1
    actors:
      TC_CUSTOMER:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - customer_id
              - status
              - engaged_party_id
              - created_dt
          keys:
            const:
              - customer_id
          dialect:
            const: sqlite
          customer_id:
            link: Query/result/customer_id
            schema: string
          status:
            link: Query/result/status
            schema: string
          engaged_party_id:
            link: Query/result/party_id
            schema: string
          created_dt:
            link: Now1/date
            schema: date
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
        status:
          type: string
        party_id:
          type: string
  TC_CUSTOMER.in.customer_id:
    type: array
    items:
      type: string
  TC_CUSTOMER.in.status:
    type: array
    items:
      type: string
  TC_CUSTOMER.in.engaged_party_id:
    type: array
    items:
      type: string
