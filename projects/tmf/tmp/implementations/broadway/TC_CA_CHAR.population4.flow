stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        out:
          parent_rows:
            schema: '#ref'
        in:
          cust_acct_id:
            external: cust_acct_id
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Stage 2:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        in:
          script:
            const: |-
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              var pfx = "CA_";
              
              self.result = [];
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v && pfx && v.indexOf(pfx) === 0) {
                    v = v.substring(pfx.length);
                  }
                  if (v) self.result.push({ customer_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/cust_acct_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: SIEBEL_SYSTEM
          sql:
            const: select * from main.SBL_CHURN_SCORE
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors: {}
  Stage 1:
    actors:
      EmitRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try {
                  if (typeof v !== 'string' && v[0] !== undefined) v = v[0];
                } catch (e) {}
                return '' + v;
              }
              
              var s_churn_score = scalar(churn_score);
              var s_risk_band = scalar(risk_band);
              var s_model_version = scalar(model_version);
              var s_scored_dt = scalar(scored_dt);
              var s_top_driver = scalar(top_driver);
              var s_parent_cust_acct_id = scalar(parent_cust_acct_id);
              
              self.result = [];
              
              if (churn_score) {
                // EAV_1
                self.result.push({
                  cust_acct_id: s_parent_cust_acct_id,
                  value_type: "SBL_CHURN_SCORE",
                  name: "churnScore",
                  value: s_churn_score
                });
              }
              
              if (risk_band) {
                // EAV_2
                self.result.push({
                  cust_acct_id: s_parent_cust_acct_id,
                  value_type: "SBL_CHURN_SCORE",
                  name: "riskBand",
                  value: s_risk_band
                });
              }
              
              if (model_version) {
                // EAV_3
                self.result.push({
                  cust_acct_id: s_parent_cust_acct_id,
                  value_type: "SBL_CHURN_SCORE",
                  name: "churnModelVersion",
                  value: s_model_version
                });
              }
              
              if (scored_dt) {
                // EAV_4
                self.result.push({
                  cust_acct_id: s_parent_cust_acct_id,
                  value_type: "SBL_CHURN_SCORE",
                  name: "churnScoredDt",
                  value: s_scored_dt
                });
              }
              
              if (top_driver) {
                // EAV_5
                self.result.push({
                  cust_acct_id: s_parent_cust_acct_id,
                  value_type: "SBL_CHURN_SCORE",
                  name: "topChurnDriver",
                  value: s_top_driver
                });
              }
              
              self.result;
          churn_score:
            link:
              path: Query/result/churn_score
              iterate: Iterate
            schema: string
            mandatory: false
          risk_band:
            link:
              path: Query/result/risk_band
              iterate: Iterate
            schema: string
            mandatory: false
          model_version:
            link:
              path: Query/result/model_version
              iterate: Iterate
            schema: string
            mandatory: false
          scored_dt:
            link:
              path: Query/result/scored_dt
              iterate: Iterate
            schema: string
            mandatory: false
          top_driver:
            link:
              path: Query/result/top_driver
              iterate: Iterate
            schema: string
            mandatory: false
          parent_cust_acct_id:
            link: PopulationArgs/parent_rows/cust_acct_id
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      TC_CA_CHAR:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - cust_acct_id
              - value_type
              - name
              - value
          keys:
            const:
              - cust_acct_id
              - name
              - value
          dialect:
            const: sqlite
          command:
            const: upsert
          cust_acct_id:
            link: EmitRows/result/cust_acct_id
            schema: string
          value_type:
            link: EmitRows/result/value_type
            schema: string
          name:
            link: EmitRows/result/name
            schema: string
          value:
            link: EmitRows/result/value
            schema: string
          params:
            link:
              path: EmitRows/result
              iterate: Iterate
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        cust_acct_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        churn_score:
          type: string
        risk_band:
          type: string
        model_version:
          type: string
        scored_dt:
          type: string
        top_driver:
          type: string
  EmitRows.out.result:
    type: array
    items:
      type: object
