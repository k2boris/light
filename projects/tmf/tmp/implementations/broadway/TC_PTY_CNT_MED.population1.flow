stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
  Stage 3:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        height: 199
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ party_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      XRefBridge:
        parent: SourceDbQuery
        height: 258
        in:
          interface:
            const: SIEBEL_SYSTEM
          sql:
            const: SELECT customer_id FROM main.SBL_CUSTOMER
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      QueryJoin:
        parent: SourceDbQuery
        height: 229
        in:
          interface:
            const: BSCS_SYSTEM
          sql:
            const: |-
              SELECT DISTINCT
                  t2.is_primary AS is_primary,
                  t3.line1 AS line1,
                  t1.customer_id AS customer_id
              FROM BSCS_BILLING_ACCOUNT t1
              JOIN BSCS_ACCOUNT_ADDRESS t2 ON t1.customer_id = t2.billing_account_id
              JOIN BSCS_ADDRESS t3 ON t2.billing_account_id = t3.address_id
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: XRefBridge/result
        out:
          result:
            schema: '#ref'
  Stage 1:
    actors:
      ProjectRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try { if (typeof v !== 'string' && v[0] !== undefined) v = v[0]; } catch (e) {}
                return '' + v;
              }
              self.result = [];
              self.result.push({
                party_id: scalar(parent_party_id),
                medium_type: "postalAddress",
                preferred_flag: scalar(is_primary),
                characteristic_json: scalar(line1)
              });
              self.result;
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
          is_primary:
            link:
              path: QueryJoin/result/is_primary
              iterate: Iterate
            schema: string
            mandatory: false
          line1:
            link:
              path: QueryJoin/result/line1
              iterate: Iterate
            schema: string
            mandatory: false
          customer_id:
            link:
              path: QueryJoin/result/customer_id
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      TC_PTY_CNT_MED:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - party_id
              - medium_type
              - preferred_flag
              - characteristic_json
          keys:
            const:
              - party_id
              - medium_type
              - characteristic_json
          dialect:
            const: sqlite
          params:
            link:
              path: ProjectRows/result
              iterate: Iterate
          command:
            const: upsert
          party_id:
            link: ProjectRows/result/party_id
            schema: string
          medium_type:
            link: ProjectRows/result/medium_type
            schema: string
          preferred_flag:
            link: ProjectRows/result/preferred_flag
            schema: string
          characteristic_json:
            link: ProjectRows/result/characteristic_json
            schema: string
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  QueryJoin.out.result:
    type: array
    items:
      type: object
      properties:
        is_primary:
          type: string
        line1:
          type: string
        customer_id:
          type: string
  ProjectRows.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        medium_type:
          type: string
        preferred_flag:
          type: string
        characteristic_json:
          type: string
  XRefBridge.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
