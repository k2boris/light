stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        out:
          parent_rows:
            schema: '#ref'
        in:
          party_id:
            external: party_id
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Stage 2:
    actors:
      RenameAndChangeValue:
        parent: JavaScript
        in:
          script:
            const: |-
              self.result = [];
              
              var s = "";
              if (inputs !== null && inputs !== undefined) {
                s = "" + inputs;
              }
              
              s = s.trim().replace(/^\[/, "").replace(/\]$/, "");
              
              if (s) {
                var parts = s.split(",");
                for (var i = 0; i < parts.length; i++) {
                  var v = parts[i].trim().replace(/^\[/, "").replace(/\]$/, "");
                  if (v) self.result.push({ party_id: v });
                }
              }
              
              self.result;
          inputs:
            link:
              path: PopulationArgs/parent_rows/party_id
              pos: 0
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: SIEBEL_SYSTEM
          sql:
            const: select * from main.SBL_CUSTOMER
          rowsGeneratorDistribution:
            const:
              distribution: uniform
              round: true
              type: integer
              minimum: 0
              maximum: 10
          parent_rows:
            link: RenameAndChangeValue/result
          luid_column_name:
            const: select party_id, msisdn from SIEBEL_SYSTEM.SBL_CUSTOMER
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors: {}
  Stage 1:
    actors:
      EmitRows:
        parent: JavaScript
        in:
          script:
            const: |-
              function scalar(v) {
                if (v === null || v === undefined) return null;
                try {
                  if (typeof v !== 'string' && v[0] !== undefined) v = v[0];
                } catch (e) {}
                return '' + v;
              }
              
              var s_party_id = scalar(party_id);
              var s_email = scalar(email);
              var s_msisdn = scalar(msisdn);
              
              self.result = [];
              
              if (party_id && email) {
                // EMAIL
                self.result.push({
                  party_id: s_party_id,
                  medium_type: "emailAddress",
                  preferred_flag: (s_msisdn ? 0 : 1),
                  characteristic_json: s_email
                });
              }
              
              if (party_id && msisdn) {
                // PHONE
                self.result.push({
                  party_id: s_party_id,
                  medium_type: "telephoneNumber",
                  preferred_flag: 1,
                  characteristic_json: s_msisdn
                });
              }
              
              self.result;
          party_id:
            link:
              path: Query/result/party_id
              iterate: Iterate
            schema: string
            mandatory: false
          email:
            link:
              path: Query/result/email
              iterate: Iterate
            schema: string
            mandatory: false
          msisdn:
            link:
              path: Query/result/msisdn
              iterate: Iterate
            schema: string
            mandatory: false
          parent_party_id:
            link: PopulationArgs/parent_rows/party_id
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      TC_PTY_CNT_MED:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
              - party_id
              - medium_type
              - preferred_flag
              - characteristic_json
          keys:
            const:
              - party_id
              - medium_type
              - characteristic_json
          dialect:
            const: sqlite
          command:
            const: upsert
          party_id:
            link: EmitRows/result/party_id
            schema: string
          medium_type:
            link: EmitRows/result/medium_type
            schema: string
          preferred_flag:
            link: EmitRows/result/preferred_flag
            schema: string
          characteristic_json:
            link: EmitRows/result/characteristic_json
            schema: string
          params:
            link:
              path: EmitRows/result
              iterate: Iterate
  Post Load: {}
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  RenameAndChangeValue.in.inputs:
    type: array
    items:
      type: object
  RenameAndChangeValue.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        party_id:
          type: string
        email:
          type: string
        msisdn:
          type: string
  EmitRows.out.result:
    type: array
    items:
      type: object
